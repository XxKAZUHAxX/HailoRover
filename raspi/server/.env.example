# ── Engine ──
INFERENCE_ENGINE=onnx          # "onnx" (CPU, Docker) or "hailo" (NPU, Pi bare-metal)

# ── Hailo (only used when INFERENCE_ENGINE=hailo) ──
# HEF_PATH=yolov8m             # name or path; auto-downloaded if missing (hailo8 → yolov8m, hailo8l → yolov8s)
# LABELS_JSON=                 # custom labels json for hailofilter; empty = COCO default
# HAILO_ARCH=                  # hailo8 | hailo8l | hailo10h; empty = .env/auto-detect
# HAILO_QUEUE_SIZE=2
# HAILO_WATCHDOG=false
# HAILO_STARTUP_TIMEOUT=60

# ── Camera (hailo mode: consumed by the GStreamer pipeline) ──
CAMERA_DEVICE=/dev/video0
CAMERA_WIDTH=640
CAMERA_HEIGHT=480
CAMERA_FPS=30
